{
  "name": "split-bill-app",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "A wizard for splitting a shared bill fairly — evenly or item by item — with exact-cent rounding, no backend and no accounts.",
  "author": "nafuza1299",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nafuza1299/split-bill-app.git"
  },
  "homepage": "https://split-ur-bill.vercel.app/",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "react",
    "typescript",
    "vite",
    "zustand",
    "bill-splitting",
    "receipt"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@tailwindcss/vite": "^4.3.3",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
